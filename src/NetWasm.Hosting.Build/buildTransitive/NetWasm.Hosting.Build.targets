<Project>

  <PropertyGroup>
    <!--
      When true, NetWasm will produce a wasm binary that does not use SIMD instructions.
      This is done by removing SIMD-related target features from the toolchain feature list,
      forcing scalar code generation paths.

      Usage:
        <NetWasmNoSimd>true</NetWasmNoSimd>
    -->
    <NetWasmNoSimd Condition="'$(NetWasmNoSimd)' == ''">false</NetWasmNoSimd>
  </PropertyGroup>

  <!-- Existing targets/props below -->

  <ItemGroup>
    <_NetWasmToolchainFeature Include="$(NetWasmToolchainFeatures)" Condition="'$(NetWasmToolchainFeatures)' != ''" />
  </ItemGroup>

  <!-- Normalize the feature list into a semicolon-separated property -->
  <PropertyGroup>
    <_NetWasmToolchainFeatures_Original>$(NetWasmToolchainFeatures)</_NetWasmToolchainFeatures_Original>
  </PropertyGroup>

  <!--
    If NetWasmNoSimd=true, strip SIMD feature flags.

    Notes:
    - We handle common spellings used by LLVM/clang/wasm toolchains: simd128 and relaxed-simd.
    - This keeps default behavior unchanged when the property is not set.
  -->
  <PropertyGroup Condition="'$(NetWasmNoSimd)' == 'true'">
    <!-- Remove simd128 / relaxed-simd from a semi-colon separated list -->
    <NetWasmToolchainFeatures>$([System.String]::Copy('$(_NetWasmToolchainFeatures_Original)').Replace('simd128;', '').Replace(';simd128', '').Replace('simd128', '').Replace('relaxed-simd;', '').Replace(';relaxed-simd', '').Replace('relaxed-simd', ''))</NetWasmToolchainFeatures>
  </PropertyGroup>

</Project>
